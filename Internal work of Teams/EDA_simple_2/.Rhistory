x
sudden_plunge <- dur_by_hour_diff %>%
filter(!is.na(change)) %>%
slice_min(change, n = 1)
plunge_hour <- sudden_plunge$hour
plunge_hour
ggplot(dur_by_hour, aes(hour, median_duration, color = dataset)) +
geom_line(linewidth = 1) +
geom_vline(xintercept = plunge_hour, linetype = "dashed", color = "black") +
annotate("text", x = plunge_hour, y = max(dur_by_hour$median_duration),
label = paste("Plunge at hour", plunge_hour), vjust = -0.5)
car_durations <- car %>%
summarise(
.by = contact_session_id,
start_time = min(activity_start_timestamp, na.rm = TRUE),
end_time   = max(activity_start_timestamp, na.rm = TRUE),
duration   = as.numeric(end_time - start_time, units = "secs")
) %>%
mutate(
# derive hour from start_time first
start_hour = hour(start_time),
end_hour   = hour(end_time),
# choose which hour to assign dynamically
hour = if_else(start_hour < 17, start_hour, end_hour)
)
car_durations <-
car_durations |>
mutate(duration = parse_number(as.character(duration)))
dur_by_hour_car <-
car_durations |>
summarize(
.by = hour,
median_duration = median(duration, na.rm = TRUE)
) |>
mutate(dataset = "CAR")
dur_by_hour <-
bind_rows(dur_by_hour_car, dur_by_hour_all_calls)
dur_by_hour |>
ggplot(aes(hour, median_duration, color = dataset)) +
geom_line(linewidth = 1)
dur_by_hour <-
bind_rows(dur_by_hour_car, dur_by_hour_all_calls)
dur_by_hour |>
ggplot(aes(hour, median_duration, color = dataset)) +
geom_line(linewidth = 1)
dur_by_hour_all_calls <-
all_calls_durations |>
summarize(
.by = hour,
median_duration = median(duration_release_time_answer_time, na.rm = TRUE)) |>
mutate(dataset = "All Calls")
dur_by_hour <-
bind_rows(dur_by_hour_car, dur_by_hour_all_calls)
dur_by_hour |>
ggplot(aes(hour, median_duration, color = dataset)) +
geom_line(linewidth = 1)
dur_by_hour_diff <- dur_by_hour %>%
group_by(dataset) %>%
arrange(hour) %>%
mutate(
change = median_duration - lag(median_duration)
)
sudden_plunge <- dur_by_hour_diff %>%
filter(!is.na(change)) %>%
slice_min(change, n = 1)
plunge_hour <- sudden_plunge$hour
plunge_hour
dur_by_hour %>%
ggplot(aes(hour, median_duration, color = dataset, fill = dataset)) +
# translucent ribbons to show overlap zones
geom_line(linewidth = 1.2, alpha = 0.9) +
geom_point(size = 2, alpha = 0.9) +
geom_area(alpha = 0.08, position = "identity") +
# clean minimal theme
theme_minimal(base_size = 14) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major = element_line(linetype = "dashed", color = "gray85"),
plot.title = element_text(face = "bold", size = 16, hjust = 0.5),
legend.position = "bottom",
legend.title = element_blank(),
legend.text = element_text(size = 12)
) +
scale_color_manual(
values = c("All Calls" = "#E15759", "CAR" = "#1B9E77")
) +
scale_fill_manual(
values = c("All Calls" = "#E15759", "CAR" = "#1B9E77")
) +
labs(
title = "Median Call Duration by Hour",
subtitle = "All Calls vs CAR — overlapping trends across hours",
x = "Hour of Day",
y = "Median Duration (seconds)"
) +
# subtle smoothing overlay to emphasize trend convergence
geom_smooth(se = FALSE, span = 0.4, linewidth = 0.6, linetype = "dotted", alpha = 0.4)
